# =============================================================================
# AÑADIR A TU CONFIGURACION NGINX EXISTENTE
# =============================================================================
# Agrega estos bloques dentro de tu server {} existente en:
# /etc/nginx/sites-available/app.opynio.com
#
# sudo nano /etc/nginx/sites-available/app.opynio.com
# =============================================================================

    # =========================================================================
    # CONFIGURACION 404 HTTP STATUS REAL (AÑADIR ESTO)
    # =========================================================================
    # Esto es CRITICO para SEO - Google reconoce el status code HTTP 404
    # Sin esto, las páginas 404 devuelven HTTP 200 (soft 404)
    # =========================================================================

    # Página de error 404 con status code real
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # Ruta /404 explícita devuelve 404 HTTP status
    location = /404 {
        return 404;
    }

# =============================================================================
