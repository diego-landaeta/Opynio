{
  // OJO: este fichero NO se llama tsconfig.json a proposito.
  //
  // Vite lee tsconfig.json si existe y ajusta como transpila (target, jsx,
  // useDefineForClassFields...). Anadir uno cambiaria la salida del build sin
  // que nadie lo haya pedido. Con otro nombre, Vite lo ignora y esto sirve solo
  // para comprobar tipos: `npm run typecheck`.
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "baseUrl": "."
  },
  "include": [
    "*.ts",
    "*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "contexts/**/*.ts",
    "contexts/**/*.tsx",
    "services/**/*.ts",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "utils/**/*.ts",
    "locales/**/*.ts"
  ]
}
