# Opynio - Apache Configuration

# Enable rewrite engine for SPA
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Correct MIME types for JavaScript
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/javascript .js
</IfModule>

# Headers for JavaScript files
<IfModule mod_headers.c>
    <FilesMatch "\.js$">
        Header set Content-Type "application/javascript"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Specific for widget.js - 1 day TTL so updates reach clients quickly
    <Files "widget.js">
        Header set Content-Type "application/javascript"
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=3600"
    </Files>
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>
